{
  "name": "measure-of-success",
  "version": "0.1.0",
  "private": true,
  "description": "Hierarchy-native KPI tracker for Jira (Forge app) — Measure of Success",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:forge": "SURFACE=issue-panel vite build -c vite.forge.config.ts && SURFACE=timeline vite build -c vite.forge.config.ts && SURFACE=settings vite build -c vite.forge.config.ts",
    "tunnel": "TITLE_SUFFIX=' (dev)' forge tunnel",
    "deploy:dev": "npm run build:forge && TITLE_SUFFIX=' (dev)' forge deploy --non-interactive -e development",
    "deploy:staging": "npm run build:forge && TITLE_SUFFIX=' (staging)' forge deploy --non-interactive -e staging",
    "deploy:prod": "npm run build:forge && TITLE_SUFFIX='' forge deploy --non-interactive -e production",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:stories": "vitest run -c vitest.stories.config.ts",
    "test:all": "vitest run && vitest run -c vitest.stories.config.ts",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@atlaskit/button": "^25.8.0",
    "@atlaskit/checkbox": "^19.3.1",
    "@atlaskit/dropdown-menu": "^21.3.1",
    "@atlaskit/icon": "^38.0.2",
    "@atlaskit/inline-edit": "^16.5.0",
    "@atlaskit/lozenge": "^17.0.7",
    "@atlaskit/modal-dialog": "^17.2.4",
    "@atlaskit/select": "^23.2.0",
    "@atlaskit/textarea": "^10.3.1",
    "@atlaskit/textfield": "^10.3.1",
    "@atlaskit/toggle": "^17.3.5",
    "@atlaskit/tokens": "^20.11.0",
    "@atlaskit/tooltip": "^24.4.5",
    "@forge/api": "^8.0.1",
    "@forge/bridge": "^6.1.0",
    "@forge/kvs": "^2.0.1",
    "@forge/resolver": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@atlaskit/platform-feature-flags": "^2.2.2",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "storybook": "^8.6.18",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
